<Files *.ini>
  ## For Apache HTTP 2.2
  #Order Allow,Deny
  #Deny from all
  ## For Apache HTTP 2.4
  Require all denied
</Files>

RewriteEngine on
#RewriteCond
RewriteBase "//usvn/"
RewriteRule ^svn/ - [L,NC]
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -l [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^.*$ - [NC,L]
RewriteRule ^.*$ index.php [NC,L]
